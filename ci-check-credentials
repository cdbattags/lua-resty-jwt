#!/bin/bash
# Check the publish credentials without publishing anything.
#
# Reads LUAROCKS_API_KEY, OPM_GITHUB_ACCOUNT and OPM_GITHUB_TOKEN from the
# environment and makes only read-only requests:
#   - LuaRocks: GET /api/1/<key>/status, the call `luarocks upload` makes first
#   - OPM: GET https://api.github.com/user with the token, which is how
#     opm.openresty.org authenticates publishers (see the opm README)
#
# Credentials never appear in a command line or in the output: curl reads the
# URL and the auth header from stdin. Exit 0 only when every check passes.
#
# Locally, without leaving the values in your shell history:
#   read -rs LUAROCKS_API_KEY; read -rs OPM_GITHUB_TOKEN
#   export LUAROCKS_API_KEY OPM_GITHUB_TOKEN OPM_GITHUB_ACCOUNT=<account>
#   ./ci-check-credentials
set -uo pipefail

fail=0
ok()   { printf 'ok    %s\n' "$*"; }
bad()  { printf 'FAIL  %s\n' "$*"; fail=1; }
warn() { printf 'warn  %s\n' "$*"; }

# minimum remaining lifetime of an expiring GitHub token, in days
MIN_DAYS="${MIN_TOKEN_DAYS:-7}"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# --- LuaRocks ---------------------------------------------------------------
if [ -z "${LUAROCKS_API_KEY:-}" ]; then
    bad "LuaRocks: LUAROCKS_API_KEY is not set"
else
    code="$(printf 'url = "https://luarocks.org/api/1/%s/status"\n' "$LUAROCKS_API_KEY" |
        curl -sS --max-time 30 -o "$tmp/lr.json" -w '%{http_code}' --config - 2>/dev/null)"
    if [ "$code" = "200" ] && grep -q '"user_id"' "$tmp/lr.json"; then
        ok "LuaRocks: API key is valid (status 200)"
    elif [ "$code" = "401" ] || [ "$code" = "403" ]; then
        bad "LuaRocks: API key rejected (HTTP $code); create a new key at https://luarocks.org/settings/api-keys"
    else
        bad "LuaRocks: unexpected response (HTTP ${code:-none})"
    fi
fi

# --- OPM (GitHub token) ------------------------------------------------------
if [ -z "${OPM_GITHUB_TOKEN:-}" ] || [ -z "${OPM_GITHUB_ACCOUNT:-}" ]; then
    bad "OPM: OPM_GITHUB_TOKEN and OPM_GITHUB_ACCOUNT must both be set"
else
    code="$(printf 'url = "https://api.github.com/user"\nheader = "Authorization: token %s"\nheader = "Accept: application/vnd.github+json"\n' "$OPM_GITHUB_TOKEN" |
        curl -sS --max-time 30 -D "$tmp/gh.headers" -o "$tmp/gh.json" -w '%{http_code}' --config - 2>/dev/null)"
    if [ "$code" != "200" ]; then
        bad "OPM: GitHub rejected the token (HTTP ${code:-none}); it is invalid, revoked or expired"
    else
        login="$(sed -n 's/^ *"login": *"\([^"]*\)".*/\1/p' "$tmp/gh.json" | head -n1)"
        account_lc="$(printf '%s' "$OPM_GITHUB_ACCOUNT" | tr '[:upper:]' '[:lower:]')"
        login_lc="$(printf '%s' "$login" | tr '[:upper:]' '[:lower:]')"
        if [ "$login_lc" = "$account_lc" ]; then
            ok "OPM: token belongs to the publishing account ($login)"
        else
            # an organization account: the token's user must be a member
            orgs="$(printf 'url = "https://api.github.com/user/orgs?per_page=100"\nheader = "Authorization: token %s"\n' "$OPM_GITHUB_TOKEN" |
                curl -sS --max-time 30 --config - 2>/dev/null |
                sed -n 's/^ *"login": *"\([^"]*\)".*/\1/p' | tr '[:upper:]' '[:lower:]')"
            if printf '%s\n' "$orgs" | grep -qx "$account_lc"; then
                ok "OPM: token user $login is a member of the publishing org $OPM_GITHUB_ACCOUNT"
            else
                bad "OPM: token belongs to $login, which is neither OPM_GITHUB_ACCOUNT nor a member of it"
            fi
        fi

        scopes="$(tr -d '\r' <"$tmp/gh.headers" | sed -n 's/^[Xx]-[Oo][Aa]uth-[Ss]copes: *//p' | head -n1)"
        if [ -z "$scopes" ]; then
            warn "OPM: no OAuth scopes reported (fine-grained token?); opm documents a classic token with user:email and read:org"
        else
            has() { printf ', %s,' "$scopes" | grep -q ", $1,"; }
            if (has user:email || has user) && (has read:org || has write:org || has admin:org); then
                ok "OPM: token scopes include user:email and read:org ($scopes)"
            else
                bad "OPM: token scopes are '$scopes'; opm needs user:email and read:org"
            fi
            extra="$(printf '%s' "$scopes" | tr ',' '\n' | sed 's/^ *//' | grep -vxE 'user:email|read:org' | paste -sd ' ' - || true)"
            if [ -n "$extra" ]; then
                warn "OPM: token has more scopes than opm needs: $extra"
            fi
        fi

        expires="$(tr -d '\r' <"$tmp/gh.headers" | sed -n 's/^[Gg]ithub-[Aa]uthentication-[Tt]oken-[Ee]xpiration: *//p' | head -n1)"
        if [ -z "$expires" ]; then
            ok "OPM: token does not expire"
        else
            exp_epoch="$(date -d "$expires" +%s 2>/dev/null || date -j -f '%Y-%m-%d %H:%M:%S %Z' "$expires" +%s 2>/dev/null || echo 0)"
            days=$(( (exp_epoch - $(date +%s)) / 86400 ))
            if [ "$exp_epoch" = "0" ]; then
                warn "OPM: could not parse the token expiry ($expires)"
            elif [ "$days" -lt "$MIN_DAYS" ]; then
                bad "OPM: token expires in $days day(s) ($expires)"
            else
                ok "OPM: token expires in $days day(s) ($expires)"
            fi
        fi
    fi
fi

if [ "$fail" -ne 0 ]; then
    echo "credentials check FAILED; nothing was published"
    exit 1
fi
echo "credentials check passed"
